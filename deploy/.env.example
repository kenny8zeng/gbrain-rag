# gbrain-rag 环境配置模板 —— 复制为 .env 并填值
# 必填
PORT=3000
ADMIN_TOKEN=change-me-to-a-long-random-token
DATABASE_URL=postgres://gbrain:gbrain@postgres:5432/gbrain
# 文档解析：DOCLING_URL 为空 → 内置 anydoc 解析器（文件类，进程内毫秒级）；配置后 → docling 服务路径（url/图片/OCR 能力）
DOCLING_URL=
# PARSER_MODE=auto（默认，按 DOCLING_URL 选择）| anydoc | docling（强制单解析器，无回退）
PARSER_MODE=auto
# 双解析器并存时首选（docling 配置时生效）：docling（默认，失败回退 anydoc）| anydoc（失败回退 docling）
PARSER_PREFERENCE=docling
# anydoc 托管 OCR（可选，扫描 PDF 自动升级；开启后文档可能离开本机）：ANYDOC_OCR=off|on
ANYDOC_OCR=off
FIRECRAWL_API_KEY=

# gbrain 引擎
GBRAIN_BIN=/usr/local/bin/gbrain
GBRAIN_SERVE_PORT=7333
GBRAIN_SERVE_ENABLED=true
DATA_DIR=/data/rag

# MCP 网关
MCP_SURFACE=starter
MCP_DEFAULT_CONCURRENCY=4

# 摄取任务
JOB_MAX_ATTEMPTS=3
JOB_TIMEOUT_MS=600000
JOB_STALE_MS=1800000
JOB_RETENTION_DAYS=30
MAX_UPLOAD_BYTES=104857600

# ---- 模型配置（供应商中立三件套：EMBEDDING_*/RERANK_*，自动映射为 gbrain 透传；原生变量优先）----
# 端点可为任意 OpenAI 兼容网关（litellm/one-api/llama-server 等）；模型名可带 provider: 前缀
# EMBEDDING_BASE_URL=http://gateway:8080/v1
# EMBEDDING_MODEL=qwen3-embedding-4b
# EMBEDDING_DIMENSIONS=2560
# EMBEDDING_API_KEY=
# RERANK_BASE_URL=http://gateway:8080/v1
# RERANK_MODEL=qwen3-reranker-0.6b
# RERANK_API_KEY=
# ---- 或原生 gbrain 变量（透传；详见 docs/deployment.md §4）----
# Chat/扩展模型（provider:model；hybrid expansion/think/autopilot 依赖）
# GBRAIN_CHAT_MODEL=deepseek:deepseek-v4-flash
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# Embedding（向量检索；未配置则检索 degraded、关键词可用）
# GBRAIN_EMBEDDING_MODEL=openai:text-embedding-3-large
# GBRAIN_EMBEDDING_DIMENSIONS=3072
# 本地 llama-server 端点（替代云端 key）：LLAMA_SERVER_BASE_URL / LLAMA_SERVER_API_KEY
# Rerank（可选，提升排序）：GBRAIN_RERANKER_MODEL + LLAMA_SERVER_RERANKER_BASE_URL / _API_KEY

# 跨域（可选）：逗号分隔来源列表；空=关闭；* = 全放行（仅受信内网）
CORS_ORIGINS=

# 警告（spec FR-013）：URL 导入不做任何地址校验，服务必须部署在与敏感内网隔离的受信环境
